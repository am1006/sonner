{
  "name": "sonner-vanilla",
  "version": "0.1.0",
  "description": "An opinionated toast component for vanilla JavaScript/TypeScript",
  "author": "am1006",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/am1006/sonner.git",
    "directory": "rails/packages/vanilla"
  },
  "homepage": "https://github.com/am1006/sonner/tree/hotwire/rails/packages/vanilla#readme",
  "bugs": {
    "url": "https://github.com/am1006/sonner/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node build.js",
    "dev": "tsc --watch & node build.js --watch",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "toast",
    "notifications",
    "vanilla",
    "javascript",
    "typescript",
    "sonner"
  ],
  "devDependencies": {
    "esbuild": "^0.27.2",
    "typescript": "^5.3.0"
  }
}
