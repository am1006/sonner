{
  "name": "sonner-stimulus",
  "version": "0.1.1",
  "description": "An opinionated toast component for Hotwire (Stimulus)",
  "author": "am1006",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/am1006/sonner.git",
    "directory": "rails/packages/stimulus"
  },
  "homepage": "https://github.com/am1006/sonner/tree/hotwire/rails/packages/stimulus#readme",
  "bugs": {
    "url": "https://github.com/am1006/sonner/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
